<Page
    x:Class="ImaginedNT.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImaginedNT.App.Controls"
    Loaded="OnLoaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequiresPointer="WhenFocused">
    <NavigationView x:Name="Navigation" IsSettingsVisible="False" PaneDisplayMode="LeftCompact"
                    IsBackButtonVisible="Collapsed" OpenPaneLength="200" AlwaysShowHeader="False"
                    SelectionChanged="OnNavigationChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="命令行" Tag="terminal" Icon="Keyboard" />
            <NavigationViewItem Content="进程" Tag="processes" Icon="AllApps" />
            <NavigationViewItem Content="虚拟文件系统" Tag="files" Icon="Folder" />
            <NavigationViewItem Content="注册表" Tag="registry" Icon="Library" />
            <NavigationViewItem Content="窗口桌面" Tag="desktop" Icon="View" />
            <NavigationViewItem Content="运行日志" Tag="logs" Icon="Document" />
            <NavigationViewItem Content="沙盒设置" Tag="sandbox" Icon="Setting" />
            <NavigationViewItem Content="运行时设置" Tag="settings" Icon="Setting" />
        </NavigationView.MenuItems>
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="ImaginedNT" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,8,0,16" Spacing="6">
                <TextBlock x:Name="RuntimeStatus" Text="正在启动 shell…" TextWrapping="Wrap" />
                <TextBlock x:Name="PageError" Foreground="Tomato" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="2" x:Name="TerminalPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <Button x:Name="StartButton" Content="启动 shell" IsEnabled="False" Click="OnStartClicked" />
                    <Button x:Name="StopButton" Content="停止" IsEnabled="False" Click="OnStopClicked" />
                    <Button Content="清屏" Click="OnClearClicked" />
                </StackPanel>
                <Border Grid.Row="1" Background="#15191F" Padding="16" CornerRadius="6">
                    <ScrollViewer x:Name="TerminalScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TerminalText" FontFamily="Consolas" FontSize="14"
                                   Foreground="#E6EDF3" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CommandInput" FontFamily="Consolas" IsEnabled="False" MaxLength="511"
                             PlaceholderText="输入命令并按 Enter；help 查看命令，上下键查看历史"
                             KeyDown="OnCommandKeyDown" />
                    <Button x:Name="SendButton" Grid.Column="1" Content="发送" Margin="8,0,0,0"
                            IsEnabled="False" Click="OnSendClicked" />
                </Grid>
            </Grid>
            <Grid Grid.Row="2" x:Name="ProcessesPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="ProcessList" SelectionChanged="OnProcessSelected" Margin="0,0,16,0" />
                <TextBox Grid.Column="1" x:Name="ProcessDetails" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas" TextWrapping="Wrap" Header="进程详情 · 线程 / 模块 / 句柄 / 内存"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
            <Grid Grid.Row="2" x:Name="FilesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="上一级" Click="OnFileUpClicked" />
                    <TextBox x:Name="FilePathInput" Grid.Column="1" Text="C:\" Margin="8,0"
                             FontFamily="Consolas" KeyDown="OnFilePathKeyDown" />
                    <Button Grid.Column="2" Content="转到" Click="OnFileGoClicked" />
                </Grid>
                <TextBlock Grid.Row="1" x:Name="SandboxPathText" TextWrapping="Wrap" Margin="0,8,0,8" />
                <ListView Grid.Row="2" x:Name="FileList" DoubleTapped="OnFileOpened" SelectionChanged="OnFileSelected" />
                <TextBox Grid.Row="3" x:Name="FilePreview" IsReadOnly="True" AcceptsReturn="True" Margin="0,12,0,0"
                         Header="文件预览" FontFamily="Consolas" TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
            <Grid Grid.Row="2" x:Name="RegistryPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="RegistryRoot" SelectedIndex="1" SelectionChanged="OnRegistryRootChanged" Margin="0,0,0,8">
                    <ComboBoxItem Content="HKEY_CLASSES_ROOT" />
                    <ComboBoxItem Content="HKEY_CURRENT_USER" />
                    <ComboBoxItem Content="HKEY_LOCAL_MACHINE" />
                    <ComboBoxItem Content="HKEY_USERS" />
                    <ComboBoxItem Content="HKEY_CURRENT_CONFIG" />
                </ComboBox>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="上一级" Click="OnRegistryUpClicked" />
                    <TextBox x:Name="RegistryPathInput" Grid.Column="1" Text="HKEY_CURRENT_USER" Margin="8,0"
                             FontFamily="Consolas" KeyDown="OnRegistryPathKeyDown" />
                    <Button Grid.Column="2" Content="转到" Click="OnRegistryGoClicked" />
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="子项 · 双击打开" Margin="12,0,0,8" />
                        <ListView Grid.Row="1" x:Name="RegistryKeys" DoubleTapped="OnRegistryKeyOpened" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="RegistryValueHeader" Text="值 · 名称 / 类型 / 数据" Margin="12,0,0,8" />
                        <ListView Grid.Row="1" x:Name="RegistryValues" FontFamily="Consolas" SelectionMode="None" />
                    </Grid>
                </Grid>
            </Grid>
            <ScrollViewer Grid.Row="2" x:Name="SandboxPage" Visibility="Collapsed">
                <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">
                    <TextBlock Text="停止 shell 后可修改，下次启动时生效。" TextWrapping="Wrap" />
                    <TextBlock Text="访问 U 盘：选择盘内文件夹并添加为驱动器，仅授权所选目录。" TextWrapping="Wrap" />
                    <ContentControl x:Name="SandboxControls" IsEnabled="False" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBox x:Name="SandboxRootInput" Header="沙盒根目录（C:）" IsReadOnly="True" TextWrapping="Wrap" />
                            <Button Content="选择根目录…" Click="OnChooseSandboxRootClicked" />
                            <TextBlock Text="其他驱动器" FontWeight="SemiBold" />
                            <ListView x:Name="DriveList" MaxHeight="300" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="DriveLetterInput" MinWidth="80" />
                                <Button Content="选择文件夹并添加…" Click="OnAddDriveClicked" />
                                <Button Content="移除选中驱动器" Click="OnRemoveDriveClicked" />
                            </StackPanel>
                            <TextBlock Text="所选文件夹直接映射为来宾驱动器，来宾的写入会修改其中的文件。" TextWrapping="Wrap" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" x:Name="DesktopPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <Button x:Name="DesktopStartButton" Content="启动窗口示例" Click="OnDesktopStartClicked" />
                    <Button x:Name="DesktopStopButton" Content="关闭桌面" IsEnabled="False"
                            Click="OnDesktopStopClicked" />
                    <TextBlock x:Name="DesktopStatus" Text="桌面未启动" VerticalAlignment="Center"
                               Foreground="#9AA4B2" />
                </StackPanel>
                <Border Grid.Row="1" Background="#0B0E13" CornerRadius="8" BorderBrush="#30363D"
                        BorderThickness="1">
                    <controls:DwmCompositor x:Name="Compositor" />
                </Border>
            </Grid>
            <ListView Grid.Row="2" x:Name="LogsPage" Visibility="Collapsed" FontFamily="Consolas"
                      SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Enabled" />
            <ContentControl Grid.Row="2" x:Name="RuntimeSettingsPage" Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </NavigationView>
</Page>
