  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
    <ProjectReference Include="..\ImaginedNT.Abstractions\ImaginedNT.Abstractions.csproj" />
    <ProjectReference Include="..\ImaginedNT.Backends.Windows\ImaginedNT.Backends.Windows.csproj" />
  </ItemGroup>
</Project>
