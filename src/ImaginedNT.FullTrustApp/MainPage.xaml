<Page
    x:Class="ImaginedNT.FullTrustApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <NavigationView x:Name="Navigation" IsSettingsVisible="False" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" OpenPaneLength="200" AlwaysShowHeader="False" SelectionChanged="OnNavigationChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="窗口桌面" Tag="desktop" Icon="Remote" />
            <NavigationViewItem Content="窗口站与桌面" Tag="stations" Icon="ViewAll" />
            <NavigationViewItem Content="命令行" Tag="terminal" Icon="Keyboard" />
            <NavigationViewItem Content="进程" Tag="processes" Icon="AllApps" />
            <NavigationViewItem Content="对象管理" Tag="objects" Icon="List" />
            <NavigationViewItem Content="虚拟文件系统" Tag="files" Icon="Folder" />
            <NavigationViewItem Content="注册表" Tag="registry" Icon="Library" />
            <NavigationViewItem Content="运行日志" Tag="logs" Icon="Message" />
            <NavigationViewItem Content="文件系统设置" Tag="sandbox" Icon="Volume" />
            <NavigationViewItem Content="运行时设置" Tag="settings" Icon="Setting" />
        </NavigationView.MenuItems>
        <Grid Padding="24,16,24,24" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="ImaginedNT" FontSize="28" FontWeight="SemiBold" />
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <TextBlock x:Name="StatusText" Text="就绪" TextWrapping="Wrap" HorizontalAlignment="Left" />
                <TextBlock x:Name="PageError" Foreground="Tomato" TextWrapping="Wrap" HorizontalAlignment="Right" />
            </Grid>
            <ContentControl Grid.Row="2" x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </NavigationView>
</Page>
