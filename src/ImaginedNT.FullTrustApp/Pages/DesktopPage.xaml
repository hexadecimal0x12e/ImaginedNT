<Page
    x:Class="ImaginedNT.FullTrustApp.Pages.DesktopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImaginedNT.FullTrustApp.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DesktopTitle" Text="来宾窗口桌面" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="窗口站管理" Click="OnManageStations" />
                <Button x:Name="FollowInputButton" Content="返回输入桌面" Click="OnFollowInput" IsEnabled="False" />
                <Button x:Name="RuntimeButton" Content="启动运行时" IsEnabled="False" Click="OnRuntimeClicked" />
                <Button x:Name="BroadcastButton" Content="全局消息" IsEnabled="False">
                    <Button.Flyout>
                        <Flyout x:Name="MessageFlyout" Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="320" Spacing="12">
                                <TextBlock Text="向所有来宾窗口（包括子窗口）投递消息。可选择常用消息，或输入十进制、0x 十六进制消息 ID。" TextWrapping="Wrap" />
                                <ComboBox x:Name="MessageInput" Header="消息 ID（uint32）" IsEditable="True" IsTextSearchEnabled="False" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="WM_NULL (0x0000)" Tag="0x0000" />
                                    <ComboBoxItem Content="WM_MOVE (0x0003)" Tag="0x0003" />
                                    <ComboBoxItem Content="WM_SIZE (0x0005)" Tag="0x0005" />
                                    <ComboBoxItem Content="WM_ACTIVATE (0x0006)" Tag="0x0006" />
                                    <ComboBoxItem Content="WM_SETFOCUS (0x0007)" Tag="0x0007" />
                                    <ComboBoxItem Content="WM_KILLFOCUS (0x0008)" Tag="0x0008" />
                                    <ComboBoxItem Content="WM_ENABLE (0x000A)" Tag="0x000A" />
                                    <ComboBoxItem Content="WM_PAINT (0x000F)" Tag="0x000F" />
                                    <ComboBoxItem Content="WM_CLOSE (0x0010)" Tag="0x0010" />
                                    <ComboBoxItem Content="WM_SHOWWINDOW (0x0018)" Tag="0x0018" />
                                    <ComboBoxItem Content="WM_KEYDOWN (0x0100)" Tag="0x0100" />
                                    <ComboBoxItem Content="WM_KEYUP (0x0101)" Tag="0x0101" />
                                    <ComboBoxItem Content="WM_CHAR (0x0102)" Tag="0x0102" />
                                    <ComboBoxItem Content="WM_COMMAND (0x0111)" Tag="0x0111" />
                                    <ComboBoxItem Content="WM_SYSCOMMAND (0x0112)" Tag="0x0112" />
                                    <ComboBoxItem Content="WM_TIMER (0x0113)" Tag="0x0113" />
                                    <ComboBoxItem Content="WM_MOUSEMOVE (0x0200)" Tag="0x0200" />
                                    <ComboBoxItem Content="WM_LBUTTONDOWN (0x0201)" Tag="0x0201" />
                                    <ComboBoxItem Content="WM_LBUTTONUP (0x0202)" Tag="0x0202" />
                                    <ComboBoxItem Content="WM_RBUTTONDOWN (0x0204)" Tag="0x0204" />
                                    <ComboBoxItem Content="WM_RBUTTONUP (0x0205)" Tag="0x0205" />
                                    <ComboBoxItem Content="WM_USER (0x0400)" Tag="0x0400" />
                                    <ComboBoxItem Content="WM_APP (0x8000)" Tag="0x8000" />
                                </ComboBox>
                                <TextBox x:Name="WParamInput" Header="wParam（64 位）" Text="0" />
                                <TextBox x:Name="LParamInput" Header="lParam（64 位）" Text="0" />
                                <TextBlock x:Name="MessageResult" TextWrapping="Wrap" />
                                <Button Content="发送到所有窗口" Click="OnBroadcastClicked" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#E8EBEF" CornerRadius="0" BorderThickness="0">
            <controls:DwmCompositor x:Name="Compositor" />
        </Border>
    </Grid>
</Page>
