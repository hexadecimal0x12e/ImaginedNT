<Page
    x:Class="ImaginedNT.FullTrustApp.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FileDriveInput" MinWidth="90" PlaceholderText="驱动器" SelectionChanged="OnFileDriveChanged" />
            <Button Grid.Column="1" Content="上一级" Click="OnFileUpClicked" />
            <TextBox x:Name="FilePathInput" Grid.Column="2" Text="C:\" FontFamily="Consolas" KeyDown="OnFilePathKeyDown" />
            <Button Grid.Column="3" Content="转到" Click="OnFileGoClicked" />
        </Grid>
        <TextBlock Grid.Row="1" x:Name="SandboxPathText" Margin="0,8" TextWrapping="Wrap" />
        <ListView Grid.Row="2" x:Name="FileList" DoubleTapped="OnFileOpened" SelectionChanged="OnFileSelected" />
        <TextBox Grid.Row="3" x:Name="FilePreview" IsReadOnly="True" AcceptsReturn="True" Margin="0,8,0,0" Header="文件预览" FontFamily="Consolas" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
