<Page
    x:Class="ImaginedNT.FullTrustApp.Pages.ObjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid ColumnSpacing="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ViewSelector" SelectedIndex="0" SelectionChanged="OnViewChanged">
                <ComboBoxItem Content="对象命名空间" />
                <ComboBoxItem Content="未注册到命名空间的对象" />
                <ComboBoxItem Content="所有对象" />
            </ComboBox>
            <Button Grid.Column="1" x:Name="UpButton" Content="上一级" Click="OnUpClicked" />
            <TextBox Grid.Column="2" x:Name="PathInput" Text="\" FontFamily="Consolas" KeyDown="OnPathKeyDown" />
            <Button Grid.Column="3" x:Name="GoButton" Content="转到" Click="OnGoClicked" />
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="筛选当前列表的名称、路径、类型、进程或句柄" TextChanged="OnSearchChanged" />
            <Button Grid.Column="1" Content="刷新" Click="OnRefreshClicked" />
        </Grid>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="SummaryText" TextWrapping="Wrap" />
        <ListView Grid.Row="3" x:Name="ObjectList" SelectionChanged="OnObjectSelected" DoubleTapped="OnObjectOpened" KeyDown="OnObjectKeyDown" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ObjectDetails" Header="对象详情"
                 IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
