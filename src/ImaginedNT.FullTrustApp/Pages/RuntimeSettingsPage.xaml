<Page
    x:Class="ImaginedNT.FullTrustApp.Pages.RuntimeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8" MaxWidth="800" HorizontalAlignment="Stretch">
            <TextBlock Text="根进程" FontSize="20" />
            <TextBlock Text="保存后在下次启动时生效，可选择沙盒外的主机可执行文件。" TextWrapping="Wrap" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RootProcessInput" Header="程序（主机完整路径或沙盒相对路径）" />
                <Button Grid.Column="1" Content="选择程序…" VerticalAlignment="Bottom" Click="OnChooseRootProcessClicked" />
            </Grid>
            <TextBox x:Name="RootArgumentsInput" Header="启动参数" />
            <Button Content="保存根进程" Click="OnSaveRootProcessClicked" />
            <TextBlock x:Name="RootProcessStatus" TextWrapping="Wrap" />
        </StackPanel>
        <ContentControl x:Name="SettingsHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Page>
