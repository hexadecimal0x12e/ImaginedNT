<Page
    x:Class="ImaginedNT.FullTrustApp.Pages.RuntimeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Loaded="OnLoaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid>
            <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                <controls:SettingsExpander Header="根进程" Description="保存后在下次启动时生效，可选择沙盒外的主机可执行文件。" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Play" />
                    </controls:SettingsExpander.HeaderIcon>
                    <Button Content="保存根进程" Click="OnSaveRootProcessClicked" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="程序" Description="主机完整路径或沙盒相对路径" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RootProcessInput" AutomationProperties.Name="根进程程序路径" />
                                <Button Grid.Column="1" Content="选择程序…" Click="OnChooseRootProcessClicked" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="启动参数" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <TextBox x:Name="RootArgumentsInput" AutomationProperties.Name="启动参数" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <TextBlock x:Name="RootProcessStatus" TextWrapping="Wrap" />
                <ContentControl x:Name="SettingsHost" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
