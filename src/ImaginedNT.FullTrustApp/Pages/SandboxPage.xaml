<Page
    x:Class="ImaginedNT.FullTrustApp.Pages.SandboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <ContentControl x:Name="SandboxControls" HorizontalContentAlignment="Stretch">
            <Grid>
                <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                    <TextBlock Text="停止来宾后修改配置，重新启动时生效。" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <controls:SettingsExpander Header="沙盒根（C:）" IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <SymbolIcon Symbol="Folder" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Description>
                            <TextBlock x:Name="RootDefinitionText" TextWrapping="Wrap" />
                        </controls:SettingsExpander.Description>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="当前路径" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                <TextBox x:Name="SandboxInput" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="沙盒根路径" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="文件夹映射" Description="选择作为 C: 根目录的主机文件夹。">
                                <Button Content="选择文件夹…" Click="OnChooseRootClicked" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="YAML 定义" Description="从 YAML 文件加载根卷映射。">
                                <Button Content="选择 YAML 定义…" Click="OnChooseRootYamlClicked" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <controls:SettingsExpander Header="其他虚拟驱动器" Description="添加文件夹映射，或为选中的卷加载 YAML 定义。" IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEDA2;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="已配置的驱动器" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                <ListView x:Name="DriveList" MaxHeight="260" AutomationProperties.Name="已配置的驱动器" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="盘符">
                                <ComboBox x:Name="DriveLetterInput" MinWidth="90" AutomationProperties.Name="盘符" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="添加驱动器" Description="选择文件夹并映射到所选盘符。">
                                <Button x:Name="AddDriveButton" Content="选择文件夹并添加…" Click="OnAddDriveClicked" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="卷 YAML 定义" Description="加载到选中的驱动器；未选中时使用上方盘符。">
                                <Button Content="加载 YAML 到选中卷…" Click="OnLoadYamlClicked" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="移除驱动器">
                                <Button x:Name="RemoveDriveButton" Content="移除选中驱动器" Click="OnRemoveDriveClicked" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <controls:SettingsCard Header="保存配置" Description="重新启动来宾时生效。" Margin="0,12,0,0">
                        <Button Content="保存配置" Click="OnSaveConfigClicked" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="沙盒目录" Description="在文件资源管理器中打开当前沙盒根目录。">
                        <Button Content="打开沙盒目录" Click="OnOpenSandboxClicked" />
                    </controls:SettingsCard>
                </StackPanel>
            </Grid>
        </ContentControl>
    </ScrollViewer>
</Page>
