<Page
    x:Class="ImaginedNT.FullTrustApp.Pages.SandboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <ScrollViewer>
        <ContentControl x:Name="SandboxControls" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="停止来宾后修改配置，重新启动时生效。" TextWrapping="Wrap" />
                <TextBlock Text="沙盒根（C:）" FontWeight="SemiBold" />
                <TextBox x:Name="SandboxInput" IsReadOnly="True" Width="600" HorizontalAlignment="Left" TextWrapping="Wrap" />
                <TextBlock x:Name="RootDefinitionText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="选择文件夹…" Click="OnChooseRootClicked" />
                    <Button Content="选择 YAML 定义…" Click="OnChooseRootYamlClicked" />
                </StackPanel>
                <TextBlock Text="其他虚拟驱动器" FontWeight="SemiBold" />
                <ListView x:Name="DriveList" MaxHeight="260" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="DriveLetterInput" MinWidth="90" />
                    <Button x:Name="AddDriveButton" Content="选择文件夹并添加…" Click="OnAddDriveClicked" />
                    <Button Content="加载 YAML 到选中卷…" Click="OnLoadYamlClicked" />
                    <Button x:Name="RemoveDriveButton" Content="移除选中驱动器" Click="OnRemoveDriveClicked" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="保存配置" Click="OnSaveConfigClicked" />
                    <Button Content="打开沙盒目录" Click="OnOpenSandboxClicked" />
                </StackPanel>
            </StackPanel>
        </ContentControl>
    </ScrollViewer>
</Page>
