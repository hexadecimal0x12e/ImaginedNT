<Page
    x:Class="ImaginedNT.FullTrustApp.Pages.WindowStationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="窗口站与桌面" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
            <ComboBox x:Name="SessionSelector" Header="会话" MinWidth="260" SelectionChanged="OnSessionSelected" />
        </StackPanel>
        <ContentControl x:Name="Management" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="窗口站" FontWeight="SemiBold" />
                    <ListView x:Name="StationList" Grid.Row="1" SelectionChanged="OnStationSelected" />
                    <TextBox x:Name="StationName" Grid.Row="2" Header="新窗口站名称" PlaceholderText="Station1" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button Content="创建" Click="OnCreateStation" />
                        <Button x:Name="DeleteStationButton" Content="删除" Click="OnDeleteStation" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="桌面" FontWeight="SemiBold" />
                    <ListView x:Name="DesktopList" Grid.Row="1" SelectionChanged="OnDesktopSelected" />
                    <TextBox x:Name="DesktopName" Grid.Row="2" Header="新桌面名称" PlaceholderText="Desktop1" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CreateDesktopButton" Content="创建" Click="OnCreateDesktop" />
                        <Button x:Name="DeleteDesktopButton" Content="删除" Click="OnDeleteDesktop" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Spacing="8">
                        <Button x:Name="ViewButton" Content="查看此桌面" Click="OnViewDesktop" />
                        <Button x:Name="SwitchButton" Content="切换为输入桌面" Click="OnSwitchDesktop" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <TextBlock Text="桌面详情" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="WinSta0 的输入桌面接收鼠标和键盘；其他桌面可查看窗口内容。" TextWrapping="Wrap" />
                        <TextBox x:Name="ArgumentsInput" Header="程序启动参数" />
                        <Button x:Name="StartProcessButton" Content="选择程序并在此桌面启动" Click="OnStartProcess" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ContentControl>
    </Grid>
</Page>
